  "history": [],
  "facts": [
    "The Raid Cart is a squad available in the Clan Capital, available when the Raid Cart Barracks is constructed (this occurs automatically after the Builder's Workshop district is unlocked, when the Capital Hall is upgraded to level 5). The squad spawns one Siege Cart and four Barbarians."
  ],
