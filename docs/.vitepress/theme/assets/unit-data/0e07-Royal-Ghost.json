  "history": [],
  "facts": [
    "The Royal Ghost has very high damage per second but very low hitpoints, and his attacks carry a brief slowing effect. For 12 seconds after deployment, he remains in stealth, ignoring walls and cannot be targeted by enemy defenses or troops."
  ],
