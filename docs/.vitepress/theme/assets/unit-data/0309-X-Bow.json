  "history": [
    {
      "date": "2026-02-23",
      "description": "Reduce charge times at all charges: Charge 1: 4d 12h -> 3d Time Charge 2: 6d 12h -> 4d 12h Time Reduce charge costs at all charges: Charge 1: 10,000,000 -> 7,000,000 Gold Charge 2: 6,250,000 -> 4,000,000 Gold"
    },
    {
      "date": "2026-04-27",
      "description": "Added the level 13 X-Bow. X-Bow13 Ground X-Bow13 Air Removed the Supercharges at level 12 Icon Supercharge ⚡ Reduced upgrade times at levels 4 to 7, and 12: Level 4: 3d -> 2d 12h Time Level 5: 3d 12h -> 3d Time Level 6: 4d -> 3d 12h Time Level 7: 4d 6h -> 4d Time Level 12: 10d 12h -> 8d Time"
    },
    {
      "date": "2026-06-16",
      "description": "Added 2 Supercharge levels for the X-Bow. Icon Supercharge ⚡"
    },
    {
      "date": "2026-11-16",
      "description": "19 本版本新增 14 级。",
      "sourceUrl": "https://supercell.com/en/games/clashofclans/blog/release-notes/the-clash-of-titans-update-is-rolling-out/",
      "sourcePublishedOn": "2026-11-16"
    }
  ],
  "facts": [
    "The X-Bow is a single-target, rapid-firing defense that is unlocked at Town Hall level 9.",
    "The X-Bow holds 1,500 rounds of bolts from its box and fires 8 times per second, and takes 3 minutes and 12 seconds for one X-Bow to unload all of its ammunition.",
    "Ground Mode, which can only target ground troops at a range of 14 tiles.",
    "Air & Ground Mode, which can target both ground and air troops at a reduced range of 11.5 tiles."
  ],
  "notices": []
