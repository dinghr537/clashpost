  "history": [
    {
      "date": "2026-05-26",
      "description": "Moved Hero Hall unlock requirement from Town Hall 7 to Town Hall 4. Hero Hall0 Reduced build cost from 800,000 to 30,000. Elixir Reduced build time from 1d to 1h. Time Reduced hitpoints at levels 1 to 3: Level 1: 2,000 -> 800 Hitpoints Level 2: 2,400 -> 1,600 Hitpoints Level 3: 2,800 -> 2,400 Hitpoints"
    }
  ],
  "facts": [
    "The Hero Hall is an army building unlocked at Town Hall level 4. It serves as a central hub for Heroes, where their assignments and upgrades can be managed.",
    "For example, if the Royal Champion can be unlocked at Town Hall 13, the Hero Hall must be upgraded to level 7 before upgrading to Town Hall 14."
  ],
