  "history": [
    {
      "date": "2026-07-13",
      "description": "Added 60 Meteor Golems and Meteormites (both temporary versions) to Multiplayer and Revenge attacks in a Mass Troops event.",
      "dateRaw": "July 13-14, 2026",
      "dateEnd": "2026-07-14"
    },
    {
      "date": "2026-07-14",
      "description": "Increased hitpoint at all levels: Level 1: 13,000 -> 14,500 Hitpoints Level 2: 14,500 -> 16,000 Hitpoints Level 3: 16,000 -> 17,500 Hitpoints Increased damage at all levels: Level 1: 450 -> 480 Damage Level 2: 500 -> 530 Damage Level 3: 550 -> 580 Damage"
    },
    {
      "date": "2026-08-31",
      "description": "修复陨石戈仑在分裂、被投掷或合体时丢失愤怒法术效果及目标的问题。",
      "sourceUrl": "https://supercell.com/en/games/clashofclans/blog/release-notes/august-update-3/",
      "sourcePublishedOn": "2026-08-30",
      "dateSourceUrl": "https://clashofclans.fandom.com/wiki/Diggy?oldid=625147#History"
    },
    {
      "date": "2026-10-20",
      "description": "提高 1–3 级生命值，分别由 14500、16000、17500 提高至 15300、16900、18500；满血分裂后的小陨石戈仑生命值相应提高至 7650、8450、9250。",
      "sourceUrl": "https://supercell.com/en/games/clashofclans/blog/news/balance-changes-incoming-october-2026/",
      "sourcePublishedOn": "2026-10-17",
      "numericSourceUrl": "https://clashfox.com/blog/balance-changes-before-town-hall-19-fire-heart-and-ruin-witch-nerfed-hogs-and-p-e-k-k-a-bu",
      "dateSourceUrl": "https://x.com/ClashofClans/status/2112450159326179560",
      "dateEvidence": "Maintenance completion on October 20 UTC; adjusted stats confirmed in-game on October 20.",
      "type": "balance"
    }
  ],
  "facts": [
    "Originally, the Meteor Golem was a Temporary Troop introduced in the Cosmic Rock event. They were unlocked after accumulating 100 Cosmic Shards in the event.",
    "The Meteor Golem is the nineteeth Elixir Troop and currently the last one unlocked by upgrading the Barracks to level 19.",
    "Each Meteormite spawned through this attack starts with half the current health of the Meteor Golem, rounded down to the nearest 1% of Meteormite health. Thus a damaged Meteor Golem will spawn damaged Meteormites upon splitting up."
  ],
  "notices": []
