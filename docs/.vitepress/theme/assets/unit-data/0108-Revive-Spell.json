  "history": [
    {
      "date": "2026-02-23",
      "description": "Added the level 5 Revive Spell."
    },
    {
      "date": "2026-08-31",
      "description": "Added a new mechanic for the Revive Spell. Previously, reviving the correct Hero was difficult, especially if they are too close to each other. Now, when selecting the Revive Spell, the defeated Heroes will now be revived by tapping their pulsing icon in the deployment bar, where it will briefly flash green before reviving them."
    }
  ],
  "facts": [
    "The Revive Spell is the ninth Elixir spell unlocked, when the Spell Factory is upgraded to level 8, requiring Town Hall 15."
  ],
