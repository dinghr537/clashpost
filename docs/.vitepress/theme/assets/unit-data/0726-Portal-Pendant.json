  "history": [
    {
      "date": "2026-08-31",
      "description": "The Portal Pendant was added to the game files."
    },
    {
      "date": "2026-09-22",
      "description": "Reduced healing on redeploy at levels 15 to 27: Level 15-17: 32% -> 31% Hitpoints Level 18-20: 34% -> 32% Hitpoints Level 21-23: 36% -> 33% Hitpoints Level 24-26: 38% -> 34% Hitpoints Level 27: 40% -> 35% Hitpoints"
    },
    {
      "date": "2026-10-08",
      "description": "Made the Portal Pendant available in the Portal Panic Medal Event."
    },
    {
      "date": "2026-10-20",
      "description": "新增被动生命值加成：1 级增加 550，每升一级增加 25，27 级增加 1200；原有回血加成保留。",
      "sourceUrl": "https://supercell.com/en/games/clashofclans/blog/news/balance-changes-incoming-october-2026/",
      "sourcePublishedOn": "2026-10-17",
      "numericSourceUrl": "https://clashfox.com/blog/balance-changes-before-town-hall-19-fire-heart-and-ruin-witch-nerfed-hogs-and-p-e-k-k-a-bu",
      "dateSourceUrl": "https://x.com/ClashofClans/status/2112450159326179560",
      "dateEvidence": "Maintenance completion on October 20 UTC; adjusted stats confirmed in-game on October 20.",
      "type": "balance"
    }
  ],
  "facts": [
    "召回容量：英雄按 25 人口、战宠通常按 20 人口计。亡灵王自身不占容量，但携带的战宠通常仍计入容量。",
    "凤凰仍为蛋形态时，只有主人被召回才会一起召回，且不额外占用人口。",
    "愤怒水母正在对主人施加洗脑效果时，会随主人一起召回，且不额外占用人口。",
    "容量不足时优先召回英雄，再按人口从高到低召回；同人口优先召回先部署的单位。战宠不继承主人的优先权，可能与主人分开召回。"
  ],
  "notices": []
